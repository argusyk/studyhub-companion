# Скопіюйте у .env і змініть значення. Реальні секрети в репозиторій не потрапляють.
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# Рядок підключення API (psycopg 3)
DATABASE_URL=postgresql+psycopg://studyhub:change-me-dev-only@localhost:5432/studyhub

# Користувач ЛИШЕ для читання (створюється у ЛР11) для Postgres-MCP
STUDYHUB_RO_PASSWORD=change-me-ro-dev-only
STUDYHUB_RO_DATABASE_URL=postgresql://studyhub_ro:change-me-ro-dev-only@localhost:5432/studyhub

# Часовий пояс кафедри (дедлайни вводяться за ним, зберігаються в UTC)
DEPARTMENT_TZ=Europe/Kyiv

# Фронтенд
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Тестовий секрет для ЛР1 (перевірка .cursorignore); вигадане значення
TEST_SECRET=studyhub-lab1
